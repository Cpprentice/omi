@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ex:   <http://example.org/> .
@prefix exOut:  <http://example.org/schemaOut#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix cco: <https://terminology.tib.eu/ts/ontologies/cco> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcat: <https://www.w3.org/ns/dcat#> .
@prefix dct: <https://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ncit: <http://purl.obolibrary.org/obo/ncit.owl> .
@prefix oeo: <https://openenergyplatform.org/ontology/oeo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sc: <http://schema.org/> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dac4: <http://datacite.org/schema/kernel-4#> .

ex:RecordToRecordRule
    a sh:NodeShape ;
    sh:targetSubjectsOf owl:versionInfo ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:construct """
            PREFIX dac4: <http://datacite.org/schema/kernel-4#>
            PREFIX owl: <http://www.w3.org/2002/07/owl#>
            CONSTRUCT {
                $this a dac4:Resource .
            }
            WHERE {
                $this owl:versionInfo ?_ .
            }
        """ ;
    ] .